# Required. Use unique credentials and at least 32 random characters for SESSION_SECRET.
APP_USERNAME=
APP_PASSWORD=
SESSION_SECRET=
# Local browser origin. Production requires your exact HTTPS origin.
APP_URL=http://localhost:5173
ANTHROPIC_API_KEY=
# Optional LinkedIn integration. Register APP_URL/api/auth/callback as redirect URI.
LI_CLIENT_ID=
LI_CLIENT_SECRET=
# Set a currently supported LinkedIn Marketing API version (YYYYMM) before publishing.
LINKEDIN_API_VERSION=
# Optional shared rate limiter for multiple serverless instances. Configure both.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
